# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# En desarrollo local (Postgres corriendo en tu máquina): DB_HOST=localhost
# En producción con docker-compose (servicio "postgres" del docker-compose.yml):
# DB_HOST=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=leybrak_db
DB_USER=leybrak_user
DB_PASSWORD=tu_password_seguro

# Mismas credenciales que arriba, pero con los nombres que espera la imagen
# oficial de Postgres — las usa el servicio "postgres" de docker-compose.yml.
# Deben coincidir siempre con DB_USER / DB_PASSWORD / DB_NAME.
POSTGRES_USER=leybrak_user
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_DB=leybrak_db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En desarrollo: http://localhost:5173 (Vite)
# En producción: https://tudominio.com
ALLOWED_ORIGIN=http://localhost:5173

# ─── Panel de administración ──────────────────────────────────────────────────
# Secreto para firmar las sesiones (JWT). Genera uno único y largo en producción,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Credenciales del admin. Solo se usan la PRIMERA vez que corres `npm run migrate`
# para crear tu usuario — después cambia la contraseña desde el panel /admin.
ADMIN_EMAIL=tu_correo@leybrak.com
ADMIN_PASSWORD=elige_una_contraseña_segura
